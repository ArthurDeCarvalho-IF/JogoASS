[autoload]

GameManager="*uid://culuuhnvmfwaj"
SceneManager="*uid://fu7e7uqq2i1i"
DoorsManager="*uid://d31ku3xd7gijr"
UserDataManager="*uid://de4x56yvxyv1"

[display]

window/size/viewport_width=1280
window/size/viewport_height=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="jogoass"

